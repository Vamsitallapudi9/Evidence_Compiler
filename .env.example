# LLM provider: "openai" or "anthropic" (the only external call the system makes).
EC_LLM_PROVIDER=openai

# --- OpenAI -----------------------------------------------------------------------------
OPENAI_API_KEY=
# Defaults for provider=openai are gpt-6-luna for both tiers; override if your account
# lists a different ID (`make check-llm` prints what your key can access).
# EC_STRONG_MODEL=gpt-6-luna
# EC_FAST_MODEL=gpt-6-luna
# Optional: reasoning effort for reasoning models (low | medium | high). Unset = model default.
# EC_OPENAI_REASONING_EFFORT=

# Per-call timeout and retries (a hung call fails after this instead of hanging the run)
EC_LLM_TIMEOUT_S=180
EC_LLM_MAX_RETRIES=2
# Optional: your model's price per 1M tokens (USD) to show estimated cost in the UI
# EC_PRICE_INPUT_PER_M=
# EC_PRICE_OUTPUT_PER_M=

# --- Anthropic --------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Defaults for provider=anthropic: claude-opus-5-5 (strong), claude-haiku-4-5 (fast)
EC_STRONG_EFFORT=medium
EC_LLM_FALLBACKS=true
# Cache LLM responses on disk (reproducible reruns)
EC_LLM_CACHE=false

# --- Hugging Face ---------------------------------------------------------------------
# Only needed for gated/private datasets (accept the terms on huggingface.co first).
HF_TOKEN=
EC_HF_MAX_ROWS=20000

# Links: the server fetches pasted links itself; private/loopback addresses are refused.
# Set true only if you need to fetch from your own LAN/intranet.
EC_ALLOW_PRIVATE_URLS=false

# Local storage (SQLite app state, DuckDB tables, uploads)
# EC_DATA_DIR=backend/var

# Demo Postgres source (created by `make db-seed`)
EC_PG_DSN=postgresql://ec_reader:ec_reader_local_only@localhost:5432/ec_demo

EC_RETRIEVAL_K=12
EC_SQL_MAX_ROWS=200
EC_SQL_TIMEOUT_MS=5000
EC_MAX_UPLOAD_MB=25
